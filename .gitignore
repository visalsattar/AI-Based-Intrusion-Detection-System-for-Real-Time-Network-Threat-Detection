# --- Secrets — NEVER commit these ---
backend/.env
.env
*.env

# --- Python ---
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.Python
venv/
env/
.venv/

# --- Node / React ---
node_modules/          # Catches the accidental root node_modules
frontend/node_modules/ # Catches the frontend node_modules
frontend/build/
npm-debug.log*

# --- Docker ---
# (nothing needed here — Dockerfile builds from source each time)

# --- Logs ---
backend/logs/
*.log

# --- Datasets & large generated artifacts ---
# Keep these out of git; document how to regenerate them in your README instead.
backend/data/preprocessed/*.csv
backend/data/preprocessed/*.npy
*.zip
*.csv

# --- AI Models & Scalers (CRITICAL) ---
backend/models/*.h5
backend/models/*.pkl

# --- Metrics ---
# If you want to ignore this file, remove the ! at the start.
!backend/models/real_metrics.json

# --- OS / Editor cruft ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
node_modules

