# backend/.env.example
# Copy this file to backend/.env and fill in your real values.
# The .env file is gitignored and must NEVER be committed to git.
#
# Without this file the system still runs normally.
# Only AbuseIPDB threat-intelligence lookups on the ThreatIntel page
# will be unavailable if the key is missing.

ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here
